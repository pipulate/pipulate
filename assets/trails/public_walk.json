{
  "schema_version": 1,
  "name": "public_walk",
  "description": "Three pages open in a browser, one at a time. There is nothing to click.\nWhen a page has loaded, type CAPTURE here and press Enter.",
  "defaults": {
    "take_screenshot": false,
    "headless": false,
    "is_notebook_context": false,
    "persistent": true,
    "profile_name": "default",
    "verbose": true,
    "override_cache": true,
    "delay_range": null
  },
  "stops": [
    {
      "name": "the_word",
      "label": "The capture word",
      "guidance": "Page 1 of 3. The first browser takes a few seconds to open.",
      "url": "https://qamy.ai/walk/1/",
      "target_slot": "slot_one",
      "harvest_regex": ".+",
      "connector": {
        "script": "connectors/noop.py",
        "argv": ["{harvested}"],
        "read_only": true
      }
    },
    {
      "name": "the_receipt",
      "label": "Page two",
      "guidance": "Page 2 of 3.",
      "url": "https://qamy.ai/walk/2/",
      "target_slot": "slot_two",
      "harvest_regex": ".+",
      "connector": {
        "script": "connectors/noop.py",
        "argv": ["{harvested}"],
        "read_only": true
      }
    },
    {
      "name": "the_two_pages",
      "label": "Two versions of one page",
      "guidance": "Page 3 of 3.",
      "url": "https://qamy.ai/walk/3/",
      "target_slot": "slot_three",
      "harvest_regex": ".+",
      "connector": {
        "script": "connectors/noop.py",
        "argv": ["{harvested}"],
        "read_only": true
      }
    }
  ]
}
